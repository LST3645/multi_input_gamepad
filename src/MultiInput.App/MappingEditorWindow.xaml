<Window x:Class="MultiInput.App.MappingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="映射编辑器"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1C" FontFamily="Microsoft YaHei UI" Foreground="#E8E8E8"
        ShowInTaskbar="False">

    <StackPanel Margin="18,16,18,16">
        <!-- 来源选择 + 右上「完成」（取消 = 关闭窗口） -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="SourceRow" Orientation="Horizontal" HorizontalAlignment="Left">
                <RadioButton x:Name="SourceKeyboard" Content="键盘" Style="{StaticResource SegmentRadio}" IsChecked="True" />
                <RadioButton x:Name="SourceMouse" Content="鼠标" Style="{StaticResource SegmentRadio}" />
                <RadioButton x:Name="SourceMouseAxis" Content="鼠标移动" Style="{StaticResource SegmentRadio}" Margin="0" />
            </StackPanel>

            <Button x:Name="OkButton" Grid.Column="1" Content="完成" Style="{StaticResource SmallButton}"
                    MinWidth="84" Padding="14,6" Background="#2E5FBF" VerticalAlignment="Center" />
        </Grid>

        <!-- —— 键盘 —— -->
        <StackPanel x:Name="KeyboardPanel">
            <TextBlock Text="输入键（点击后按下要映射的键）" Style="{StaticResource FieldLabel}" />
            <!-- 宽度对齐上方「鼠标移动」按钮的右缘 -->
            <Border x:Name="KeyBox" Height="28" CornerRadius="6" Background="#232326"
                    BorderBrush="#3A3A3E" BorderThickness="1" Cursor="Hand"
                    HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=SourceRow}">
                <TextBlock x:Name="KeyBoxText" Text="点击此处，然后按键" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A8A92" />
            </Border>
        </StackPanel>

        <!-- —— 鼠标（按键 + 滚轮）—— -->
        <StackPanel x:Name="MousePanel" Visibility="Collapsed">
            <TextBlock Text="鼠标按键 / 滚轮（点击选择；滚轮持续滚动＝按住，停滚约 0.12 秒＝松开）"
                       Style="{StaticResource FieldLabel}" />

            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 左侧：上 X2 / 下 X1 -->
                <StackPanel Grid.Column="0" Grid.RowSpan="3" VerticalAlignment="Center" Margin="0,0,14,0">
                    <RadioButton x:Name="MouseX2" Content="X2" Style="{StaticResource PickSmall}" MinWidth="56" />
                    <RadioButton x:Name="MouseX1" Content="X1" Style="{StaticResource PickSmall}" MinWidth="56" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 右侧十字：上滚 / 左键 / 中键 / 右键 / 下滚 -->
                <RadioButton x:Name="WheelUp" Content="上滚" Style="{StaticResource PickSmall}" Grid.Row="0" Grid.Column="2" />
                <RadioButton x:Name="MouseLeft" Content="左键" Style="{StaticResource PickSmall}" Grid.Row="1" Grid.Column="1" />
                <RadioButton x:Name="MouseMiddle" Content="中键" Style="{StaticResource PickSmall}" Grid.Row="1" Grid.Column="2" />
                <RadioButton x:Name="MouseRight" Content="右键" Style="{StaticResource PickSmall}" Grid.Row="1" Grid.Column="3" />
                <RadioButton x:Name="WheelDown" Content="下滚" Style="{StaticResource PickSmall}" Grid.Row="2" Grid.Column="2" />
            </Grid>
        </StackPanel>

        <!-- —— 鼠标移动 —— -->
        <StackPanel x:Name="AxisPanel" Visibility="Collapsed">
            <TextBlock Text="水平位移" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AxisXNone" Content="不使用" Style="{StaticResource PickSmall}" IsChecked="True" />
                <RadioButton x:Name="AxisXLeftX" Content="左摇杆X" Style="{StaticResource PickSmall}" />
                <RadioButton x:Name="AxisXLeftY" Content="左摇杆Y" Style="{StaticResource PickSmall}" />
                <RadioButton x:Name="AxisXRightX" Content="右摇杆X" Style="{StaticResource PickSmall}" />
                <RadioButton x:Name="AxisXRightY" Content="右摇杆Y" Style="{StaticResource PickSmall}" />
            </StackPanel>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="移动量" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" x:Name="MoveAmountXBox" Style="{StaticResource Input}" Text="1.00" />
                <TextBlock Grid.Column="2" Text="位移量" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="18,0,10,0" />
                <TextBox Grid.Column="3" x:Name="DisplacementXBox" Style="{StaticResource Input}" Text="0.020" />
            </Grid>

            <TextBlock Text="垂直位移（下移取负）" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AxisYNone" Content="不使用" Style="{StaticResource PickSmall}" IsChecked="True" />
                <RadioButton x:Name="AxisYLeftX" Content="左摇杆X" Style="{StaticResource PickSmall}" />
                <RadioButton x:Name="AxisYLeftY" Content="左摇杆Y" Style="{StaticResource PickSmall}" />
                <RadioButton x:Name="AxisYRightX" Content="右摇杆X" Style="{StaticResource PickSmall}" />
                <RadioButton x:Name="AxisYRightY" Content="右摇杆Y" Style="{StaticResource PickSmall}" />
            </StackPanel>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="移动量" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" x:Name="MoveAmountYBox" Style="{StaticResource Input}" Text="1.00" />
                <TextBlock Grid.Column="2" Text="位移量" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="18,0,10,0" />
                <TextBox Grid.Column="3" x:Name="DisplacementYBox" Style="{StaticResource Input}" Text="0.020" />
            </Grid>

            <TextBlock x:Name="PreviewText" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="" />
        </StackPanel>

        <!-- —— 输出（键盘 / 鼠标）—— -->
        <StackPanel x:Name="OutputPanel" Margin="0,16,0,0">
            <TextBlock Text="输出手柄按键（点选目标；LT/RT 为 10 级滑动条；摇杆为四分圆方向键）" Style="{StaticResource FieldLabel}" />

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- LT / RT 10 级可拖拽进度条（跨 LB 行 + 摇杆行） -->
                <StackPanel x:Name="LtWell" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="LT" FontSize="11" Foreground="#9A9AA2" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <Grid x:Name="LtBarHost" Width="26" Height="100" Background="Transparent" />
                    <TextBlock x:Name="LtPercent" Text="100%" FontSize="11" Foreground="#E0A030" Width="36" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- RT 10 级可拖拽进度条 -->
                <StackPanel x:Name="RtWell" Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Margin="10,0,0,0">
                    <TextBlock Text="RT" FontSize="11" Foreground="#9A9AA2" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <Grid x:Name="RtBarHost" Width="26" Height="100" Background="Transparent" />
                    <TextBlock x:Name="RtPercent" Text="100%" FontSize="11" Foreground="#E0A030" Width="36" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 肩键（与其他按键同高 32，略宽以便放 LB/RB 文本） -->
                <RadioButton x:Name="PickLB" Content="LB" Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource PickSquare}" Width="46" HorizontalAlignment="Left"
                             VerticalAlignment="Center" Margin="24,0,0,0" />
                <RadioButton x:Name="PickRB" Content="RB" Grid.Row="0" Grid.Column="2"
                             Style="{StaticResource PickSquare}" Width="46" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Margin="0,0,24,0" />

                <!-- 左摇杆：四分圆方向键（上 / 右 / 下 / 左） -->
                <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Grid x:Name="LeftStickGroup" Width="80" Height="80" HorizontalAlignment="Center">
                        <RadioButton x:Name="PickLYPlus" Style="{StaticResource StickSector}" Content="{StaticResource SectorUp}"
                                     ToolTip="左摇杆 上（Y+）" />
                        <RadioButton x:Name="PickLXPlus" Style="{StaticResource StickSector}" Content="{StaticResource SectorRight}"
                                     ToolTip="左摇杆 右（X+）" />
                        <RadioButton x:Name="PickLYMinus" Style="{StaticResource StickSector}" Content="{StaticResource SectorDown}"
                                     ToolTip="左摇杆 下（Y−）" />
                        <RadioButton x:Name="PickLXMinus" Style="{StaticResource StickSector}" Content="{StaticResource SectorLeft}"
                                     ToolTip="左摇杆 左（X−）" />
                    </Grid>
                    <TextBlock Text="左摇杆" FontSize="11" Foreground="#9A9AA2" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <!-- 右摇杆：四分圆方向键（上 / 右 / 下 / 左） -->
                <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Grid x:Name="RightStickGroup" Width="80" Height="80" HorizontalAlignment="Center">
                        <RadioButton x:Name="PickRYPlus" Style="{StaticResource StickSector}" Content="{StaticResource SectorUp}"
                                     ToolTip="右摇杆 上（Y+）" />
                        <RadioButton x:Name="PickRXPlus" Style="{StaticResource StickSector}" Content="{StaticResource SectorRight}"
                                     ToolTip="右摇杆 右（X+）" />
                        <RadioButton x:Name="PickRYMinus" Style="{StaticResource StickSector}" Content="{StaticResource SectorDown}"
                                     ToolTip="右摇杆 下（Y−）" />
                        <RadioButton x:Name="PickRXMinus" Style="{StaticResource StickSector}" Content="{StaticResource SectorLeft}"
                                     ToolTip="右摇杆 左（X−）" />
                    </Grid>
                    <TextBlock Text="右摇杆" FontSize="11" Foreground="#9A9AA2" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <!-- 十字键 -->
                <Grid Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="PickDUp" Content="↑" Style="{StaticResource PickSquare}" Grid.Row="0" Grid.Column="1" />
                    <RadioButton x:Name="PickDLeft" Content="←" Style="{StaticResource PickSquare}" Grid.Row="1" Grid.Column="0" />
                    <RadioButton x:Name="PickDRight" Content="→" Style="{StaticResource PickSquare}" Grid.Row="1" Grid.Column="2" />
                    <RadioButton x:Name="PickDDown" Content="↓" Style="{StaticResource PickSquare}" Grid.Row="2" Grid.Column="1" />
                </Grid>

                <!-- ABXY -->
                <Grid Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="PickY" Content="Y" Style="{StaticResource PickSquare}" Grid.Row="0" Grid.Column="1" />
                    <RadioButton x:Name="PickX" Content="X" Style="{StaticResource PickSquare}" Grid.Row="1" Grid.Column="0" />
                    <RadioButton x:Name="PickB" Content="B" Style="{StaticResource PickSquare}" Grid.Row="1" Grid.Column="2" />
                    <RadioButton x:Name="PickA" Content="A" Style="{StaticResource PickSquare}" Grid.Row="2" Grid.Column="1" />
                </Grid>

                <!-- View / Menu / L3 / R3 -->
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <RadioButton x:Name="PickView" Content="View" Style="{StaticResource PickSmall}" />
                    <RadioButton x:Name="PickMenu" Content="Menu" Style="{StaticResource PickSmall}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <RadioButton x:Name="PickL3" Content="L3" Style="{StaticResource PickSmall}" />
                    <RadioButton x:Name="PickR3" Content="R3" Style="{StaticResource PickSmall}" />
                </StackPanel>
            </Grid>

            <!-- 触发方式 + 右侧「+ / ⌫」 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeInstant" Content="立即" Style="{StaticResource PickSmall}" IsChecked="True" />
                    <RadioButton x:Name="ModeDelay" Content="延迟" Style="{StaticResource PickSmall}" />
                    <TextBox x:Name="DelayBox" Style="{StaticResource Input}" Width="62" Text="100" IsEnabled="False" />
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#9A9AA2" />

                    <CheckBox x:Name="RepeatCheck" Content="连按" Foreground="#E8E8E8" VerticalAlignment="Center" Margin="22,0,0,0" />
                    <TextBox x:Name="RepeatMsBox" Style="{StaticResource Input}" Width="62" Margin="10,0,0,0" Text="100" IsEnabled="False" />
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#9A9AA2" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AddSlotButton" Content="+" Style="{StaticResource SmallButton}" Width="34" Height="28"
                            Padding="0" FontSize="17" FontWeight="Bold" ToolTip="添加一个输出" />
                    <Button x:Name="RemoveLastButton" Content="⌫" Style="{StaticResource SmallButton}" Width="34" Height="28"
                            Padding="0" Margin="8,0,0,0" ToolTip="删除当前输出" />
                </StackPanel>
            </Grid>

            <!-- 分割线 -->
            <Border Height="1" Background="#3A3A3E" Margin="0,14,0,0" />

            <!-- 已选映射（窗口最下方）-->
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="已选映射（延迟逐槽累加：无延迟＝与上一项同时按下）" Style="{StaticResource FieldLabel}" />
                <WrapPanel x:Name="ChipsPanel" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#E05A4F" FontSize="12" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</Window>
