<Window x:Class="MultiInputGamepad.App.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名配置"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#1A1A1C" FontFamily="Microsoft YaHei UI" Foreground="#E8E8E8">

    <StackPanel Margin="18,16,18,16">
        <TextBlock Text="配置名（不能与已有配置重名）" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Style="{StaticResource Input}" />

        <TextBlock x:Name="ErrorText" Foreground="#E05A4F" FontSize="12" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SmallButton}" Width="72" Margin="0,0,8,0" Click="OnCancel" />
            <Button Content="确定" Style="{StaticResource SmallButton}" Width="72" Background="#2E5FBF" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
