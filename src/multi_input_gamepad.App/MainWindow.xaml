<Window x:Class="MultiInputGamepad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="多输入整合手柄"
        Width="1280" MinWidth="1280" MaxWidth="1280" SizeToContent="Height" ResizeMode="NoResize"
        Background="#1A1A1C"
        FontFamily="Microsoft YaHei UI"
        Foreground="#E8E8E8">

    <Window.Resources>
        <!-- 手柄面板模板：输入端 / 输出端共用（DataContext = PadVm） -->
        <DataTemplate x:Key="PadTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- LT 竖向：上对齐 LB，下对齐左摇杆底部 -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="34" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="LT" FontSize="10" Foreground="#9A9AA2" HorizontalAlignment="Center" />
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Border Background="#2A2A2E" CornerRadius="4" />
                            <Border Background="#E0A030" CornerRadius="4" RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="{Binding LeftTrigger, Mode=OneWay}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding LeftTriggerText}" FontSize="10"
                                   Foreground="#9A9AA2" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </Grid>

                    <!-- RT 竖向：上对齐 RB，下对齐右摇杆底部 -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Width="34" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="RT" FontSize="10" Foreground="#9A9AA2" HorizontalAlignment="Center" />
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Border Background="#2A2A2E" CornerRadius="4" />
                            <Border Background="#E0A030" CornerRadius="4" RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="{Binding RightTrigger, Mode=OneWay}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding RightTriggerText}" FontSize="10"
                                   Foreground="#9A9AA2" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </Grid>

                    <!-- 肩键 LB/RB -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PadKey}" Width="68"
                            HorizontalAlignment="Left" Margin="16,0,0,0"
                            Background="{Binding LB, Converter={StaticResource OnOff}, ConverterParameter=#4C6EF5}">
                        <TextBlock Style="{StaticResource PadKeyText}" Text="LB" />
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PadKey}" Width="68"
                            HorizontalAlignment="Right" Margin="0,0,16,0"
                            Background="{Binding RB, Converter={StaticResource OnOff}, ConverterParameter=#4C6EF5}">
                        <TextBlock Style="{StaticResource PadKeyText}" Text="RB" />
                    </Border>

                <!-- 摇杆 -->
                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <Grid Width="80" Height="80" HorizontalAlignment="Center">
                            <Ellipse Width="72" Height="72" Stroke="#3A3A3E" StrokeThickness="2" Fill="#161618"
                                     Visibility="{Binding IsCircular, Converter={StaticResource BoolToVis}}" />
                            <Rectangle Width="72" Height="72" Stroke="#3A3A3E" StrokeThickness="2" Fill="#161618"
                                       RadiusX="3" RadiusY="3"
                                       Visibility="{Binding IsSquare, Converter={StaticResource BoolToVis}}" />
                            <Ellipse Width="20" Height="20" Fill="#4C9AFF">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="{Binding LStickDotX}" Y="{Binding LStickDotY}" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{Binding LStickText}" FontSize="11" Foreground="#CFCFD6" HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <Grid Width="80" Height="80" HorizontalAlignment="Center">
                            <Ellipse Width="72" Height="72" Stroke="#3A3A3E" StrokeThickness="2" Fill="#161618"
                                     Visibility="{Binding IsCircular, Converter={StaticResource BoolToVis}}" />
                            <Rectangle Width="72" Height="72" Stroke="#3A3A3E" StrokeThickness="2" Fill="#161618"
                                       RadiusX="3" RadiusY="3"
                                       Visibility="{Binding IsSquare, Converter={StaticResource BoolToVis}}" />
                            <Ellipse Width="20" Height="20" Fill="#4C9AFF">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="{Binding RStickDotX}" Y="{Binding RStickDotY}" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{Binding RStickText}" FontSize="11" Foreground="#CFCFD6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 十字键 + ABXY -->
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PadKey}" MinWidth="34"
                                Background="{Binding DUp, Converter={StaticResource OnOff}, ConverterParameter=#8E8E96}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="↑" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PadKey}" MinWidth="34"
                                Background="{Binding DLeft, Converter={StaticResource OnOff}, ConverterParameter=#8E8E96}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="←" />
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="十字" FontSize="10" Foreground="#6A6A72"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PadKey}" MinWidth="34"
                                Background="{Binding DRight, Converter={StaticResource OnOff}, ConverterParameter=#8E8E96}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="→" />
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PadKey}" MinWidth="34"
                                Background="{Binding DDown, Converter={StaticResource OnOff}, ConverterParameter=#8E8E96}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="↓" />
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PadKey}" MinWidth="38"
                                Background="{Binding Y, Converter={StaticResource OnOff}, ConverterParameter=#D4A017}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="Y" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PadKey}" MinWidth="38"
                                Background="{Binding X, Converter={StaticResource OnOff}, ConverterParameter=#2E86DE}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="X" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PadKey}" MinWidth="38"
                                Background="{Binding B, Converter={StaticResource OnOff}, ConverterParameter=#C0392B}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="B" />
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PadKey}" MinWidth="38"
                                Background="{Binding A, Converter={StaticResource OnOff}, ConverterParameter=#27AE60}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="A" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- View / Menu / L3 / R3 -->
                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Style="{StaticResource PadKey}"
                                Background="{Binding Back, Converter={StaticResource OnOff}, ConverterParameter=#6A6A72}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="View" />
                        </Border>
                        <Border Style="{StaticResource PadKey}"
                                Background="{Binding Start, Converter={StaticResource OnOff}, ConverterParameter=#6A6A72}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="Menu" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Style="{StaticResource PadKey}" MinWidth="40"
                                Background="{Binding L3, Converter={StaticResource OnOff}, ConverterParameter=#4C9AFF}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="L3" />
                        </Border>
                        <Border Style="{StaticResource PadKey}" MinWidth="40"
                                Background="{Binding R3, Converter={StaticResource OnOff}, ConverterParameter=#4C9AFF}">
                            <TextBlock Style="{StaticResource PadKeyText}" Text="R3" />
                        </Border>
                    </StackPanel>
                </Grid>
                </Grid>

                <TextBlock Text="{Binding Footer}" FontSize="11" Foreground="#7F7F88" Margin="0,8,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- 键盘按键：普通 / 已映射（金色描边）/ 按下（蓝色）/ 不可映射（暗底、无效光标） -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="BorderBrush" Value="#3A3A3E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                    <Setter Property="Background" Value="#4C9AFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMapped}" Value="True">
                    <Setter Property="BorderBrush" Value="#E0A030" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsForbidden}" Value="True">
                    <Setter Property="Background" Value="#202024" />
                    <Setter Property="BorderBrush" Value="#3A3A3E" />
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToggledOn}" Value="True">
                    <Setter Property="BorderBrush" Value="#8B008B" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsForbidden}" Value="True" />
                        <Condition Binding="{Binding IsPressed}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#4C9AFF" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="#F2F2F2" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 捕获状态（可点击开启） + 开关 + 状态 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="多输入整合手柄" FontSize="19" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,14,0" />

            <Button Grid.Column="1" Margin="0,0,10,0" Cursor="Hand" Click="OnCapturePillClick"
                    ToolTip="点击开启捕获">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Padding="10,4"
                                Background="{Binding IsCapturing, Converter={StaticResource OnOff}, ConverterParameter=#C0392B}">
                            <TextBlock Text="{Binding CaptureText}" FontSize="12" Foreground="#FFF" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 仅文本提示：开关捕获的功能由左侧「捕获」胶囊（点击开启）与 SHIFT+ALT+\ 热键承担 -->
            <TextBlock Grid.Column="2" Text="SHIFT+ALT+\ 开关捕获" FontSize="12" Foreground="#7F7F88"
                       VerticalAlignment="Center" Margin="0,0,14,0" />

            <TextBlock Grid.Column="3" Text="{Binding HookStatus}" FontSize="12" Foreground="#7F7F88"
                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" />

            <TextBlock Grid.Column="4" Text="{Binding PadStatus}" FontSize="12" Foreground="#9A9AA2"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- 中上：左＝键盘，右＝鼠标 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="键盘（108 键）" Style="{StaticResource SectionHeader}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Keys}"
                                      Width="{Binding KeyboardPixelWidth}"
                                      Height="{Binding KeyboardPixelHeight}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding PixelX}" />
                                    <Setter Property="Canvas.Top" Value="{Binding PixelY}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding PixelWidth}" Height="{Binding PixelHeight}"
                                            Style="{StaticResource KeyCap}"
                                            MouseLeftButtonDown="OnKeyVisualClick">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource KeyCapText}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="鼠标" Style="{StaticResource SectionHeader}" />
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 鼠标外形：左/右键、滚轮上中下三段、左侧上/下侧键 -->
                        <Canvas Grid.Column="0" Width="84" Height="120" Margin="0,0,14,0">
                            <Border Canvas.Left="2" Canvas.Top="0" Width="80" Height="116"
                                    CornerRadius="14,14,22,22" Background="#161618"
                                    BorderBrush="#3A3A3E" BorderThickness="1" />

                            <Border Canvas.Left="8" Canvas.Top="6" Width="23" Height="46" CornerRadius="12,4,4,12" BorderThickness="1.5"
                                    Tag="1" Cursor="Hand" MouseLeftButtonDown="OnMouseVisualClick"
                                    BorderBrush="{Binding Mouse.LeftMapped, Converter={StaticResource OnOff}, ConverterParameter=#E0A030|#00000000}"
                                    Background="{Binding Mouse.Left, Converter={StaticResource OnOff}, ConverterParameter=#4C9AFF}" />
                            <Border Canvas.Left="53" Canvas.Top="6" Width="23" Height="46" CornerRadius="4,12,12,4" BorderThickness="1.5"
                                    Tag="2" Cursor="Hand" MouseLeftButtonDown="OnMouseVisualClick"
                                    BorderBrush="{Binding Mouse.RightMapped, Converter={StaticResource OnOff}, ConverterParameter=#E0A030|#00000000}"
                                    Background="{Binding Mouse.Right, Converter={StaticResource OnOff}, ConverterParameter=#4C9AFF}" />

                            <!-- 滚轮上：圆角三角 -->
                            <Polygon Points="42,9 48,19 36,19" StrokeLineJoin="Round" StrokeThickness="4"
                                     Fill="{Binding Mouse.WheelUp, Converter={StaticResource OnOff}, ConverterParameter=#E0A030}"
                                     Stroke="{Binding Mouse.WheelUp, Converter={StaticResource OnOff}, ConverterParameter=#E0A030}" />
                            <!-- 中键：圆角方块 -->
                            <Border Canvas.Left="35" Canvas.Top="21" Width="14" Height="11" CornerRadius="3" BorderThickness="1.5"
                                    Tag="3" Cursor="Hand" MouseLeftButtonDown="OnMouseVisualClick"
                                    BorderBrush="{Binding Mouse.MiddleMapped, Converter={StaticResource OnOff}, ConverterParameter=#E0A030|#00000000}"
                                    Background="{Binding Mouse.Middle, Converter={StaticResource OnOff}, ConverterParameter=#4C9AFF}" />
                            <!-- 滚轮下：圆角三角 -->
                            <Polygon Points="42,44 36,34 48,34" StrokeLineJoin="Round" StrokeThickness="4"
                                     Fill="{Binding Mouse.WheelDown, Converter={StaticResource OnOff}, ConverterParameter=#E0A030}"
                                     Stroke="{Binding Mouse.WheelDown, Converter={StaticResource OnOff}, ConverterParameter=#E0A030}" />

                            <!-- 滚轮上/下各自的映射描边（也是点击修改的热区） -->
                            <Border Canvas.Left="31" Canvas.Top="3" Width="22" Height="19" CornerRadius="4" BorderThickness="1.5"
                                    Background="Transparent" Tag="wheelup" Cursor="Hand" MouseLeftButtonDown="OnMouseVisualClick"
                                    BorderBrush="{Binding Mouse.WheelUpMapped, Converter={StaticResource OnOff}, ConverterParameter=#E0A030|#00000000}" />
                            <Border Canvas.Left="31" Canvas.Top="32" Width="22" Height="17" CornerRadius="4" BorderThickness="1.5"
                                    Background="Transparent" Tag="wheeldown" Cursor="Hand" MouseLeftButtonDown="OnMouseVisualClick"
                                    BorderBrush="{Binding Mouse.WheelDownMapped, Converter={StaticResource OnOff}, ConverterParameter=#E0A030|#00000000}" />

                            <!-- 左侧键：上 X2 / 下 X1 -->
                            <Border Canvas.Left="4" Canvas.Top="58" Width="10" Height="18" CornerRadius="4" BorderThickness="1.5"
                                    Tag="5" Cursor="Hand" MouseLeftButtonDown="OnMouseVisualClick"
                                    BorderBrush="{Binding Mouse.X2Mapped, Converter={StaticResource OnOff}, ConverterParameter=#E0A030|#00000000}"
                                    Background="{Binding Mouse.X2, Converter={StaticResource OnOff}, ConverterParameter=#4C9AFF}" />
                            <Border Canvas.Left="4" Canvas.Top="82" Width="10" Height="18" CornerRadius="4" BorderThickness="1.5"
                                    Tag="4" Cursor="Hand" MouseLeftButtonDown="OnMouseVisualClick"
                                    BorderBrush="{Binding Mouse.X1Mapped, Converter={StaticResource OnOff}, ConverterParameter=#E0A030|#00000000}"
                                    Background="{Binding Mouse.X1, Converter={StaticResource OnOff}, ConverterParameter=#4C9AFF}" />
                            <TextBlock Canvas.Left="17" Canvas.Top="60" Text="X2" FontSize="9" Foreground="#7F7F88" />
                            <TextBlock Canvas.Left="17" Canvas.Top="84" Text="X1" FontSize="9" Foreground="#7F7F88" />
                        </Canvas>

                        <!-- 位移向量盘（圆形） -->
                        <Grid Grid.Column="1" Width="112" Height="112" Margin="0,0,14,0">
                            <Ellipse Width="112" Height="112" Fill="#161618" Stroke="#3A3A3E" StrokeThickness="1" />
                            <Canvas Width="112" Height="112">
                                <Line X1="56" Y1="26" X2="56" Y2="86" Stroke="#2A2A2E" StrokeThickness="1" />
                                <Line X1="26" Y1="56" X2="86" Y2="56" Stroke="#2A2A2E" StrokeThickness="1" />
                                <Line X1="56" Y1="56" X2="{Binding Mouse.LineX2}" Y2="{Binding Mouse.LineY2}"
                                      Stroke="#4C9AFF" StrokeThickness="2" />
                                <Ellipse Width="12" Height="12" Fill="#4C9AFF" Canvas.Left="50" Canvas.Top="50">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="{Binding Mouse.DotX}" Y="{Binding Mouse.DotY}" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </Grid>

                        <!-- 读数（滚轮为原始增量） -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Mouse.MoveText}" FontSize="14" Foreground="#CFCFD6" />
                            <TextBlock Text="{Binding Mouse.WheelText}" FontSize="14" Foreground="#F2F2F2" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 下：左＝输入端手柄，中＝输出端手柄，右＝映射规则 -->
        <Grid Grid.Row="2" Height="404" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Width="440" Margin="0,0,10,0">
                <ContentControl Content="{Binding InputPad}" ContentTemplate="{StaticResource PadTemplate}" Focusable="False" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Width="440" Margin="0,0,10,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <ToggleButton x:Name="NormalizeCheck" DockPanel.Dock="Right" Style="{StaticResource IosToggle}"
                                      VerticalAlignment="Center" Click="OnNormalizeToggle"
                                      ToolTip="开：左右摇杆按圆形归一化（对角≈0.71，摇杆框为圆形）；关：方形，不归一化（对角可到 1,1，摇杆框为方形）" />
                        <TextBlock Text="归一化摇杆" Foreground="#E8E8E8" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                    </DockPanel>
                    <ContentControl Content="{Binding OutputPad}" ContentTemplate="{StaticResource PadTemplate}" Focusable="False" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                        <ComboBox x:Name="ProfileBox" DockPanel.Dock="Left" Width="140" Margin="0,0,6,0"
                                  Style="{StaticResource DarkCombo}" SelectionChanged="OnProfileChanged"
                                  ToolTip="切换配置（每套配置含映射 + 归一化开关 + 死区参数）；列表项右侧可重命名/删除">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#F2F2F2"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Content="✎" Width="18" Height="18" Padding="0"
                                                FontSize="11" Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                                                Tag="{Binding Name}" Click="OnRenameProfileClick"
                                                ToolTip="重命名该配置" />
                                        <Button Grid.Column="2" Content="×" Width="18" Height="18" Padding="0"
                                                FontSize="12" Margin="4,0,0,0" Style="{StaticResource SmallButton}"
                                                Tag="{Binding Name}" Click="OnDeleteProfileClick"
                                                ToolTip="删除该配置"
                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button DockPanel.Dock="Left" Content="导入" Style="{StaticResource SmallButton}"
                                Padding="10,5" Margin="0,0,6,0" Click="OnImportClick" ToolTip="把 JSON 文件导入为新配置" />
                        <Button DockPanel.Dock="Left" Content="导出" Style="{StaticResource SmallButton}"
                                Padding="10,5" Click="OnExportClick" ToolTip="把当前配置导出为 JSON 文件" />
                        <Button DockPanel.Dock="Right" Content="＋新建" Style="{StaticResource SmallButton}"
                                Padding="10,5" Click="OnAddMappingClick" />
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="捕获开启时生效 · 单击键盘/鼠标按键可直接新建或编辑"
                               FontSize="11" Foreground="#7F7F88" Margin="0,0,0,4" />

                    <TextBlock DockPanel.Dock="Top" Text="{Binding MappingNotice}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#E0A030" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#E05A4F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock DockPanel.Dock="Top" Text="暂无映射" FontSize="12" Foreground="#6A6A72"
                               Margin="2,2,0,0"
                               Visibility="{Binding IsMappingListEmpty, Converter={StaticResource BoolToVis}}" />

                    <ScrollViewer x:Name="MappingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        
                        <ItemsControl ItemsSource="{Binding Mappings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1B1B1E" CornerRadius="5" Padding="8,6" Margin="0,0,0,5"
                                            Cursor="Hand" MouseLeftButtonDown="OnMappingRowClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding InputText}" FontSize="12"
                                                           Foreground="#E8E8E8" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                                           Foreground="#8A8A92" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="×" Width="22" Height="22"
                                                    FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Style="{StaticResource SmallButton}" Padding="0"
                                                    Click="OnDeleteMappingClick" Tag="{Binding}"
                                                    ToolTip="删除该映射" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底：操作说明（单行） -->
        <TextBlock Grid.Row="3" Margin="2,8,0,0" FontSize="11" Foreground="#7F7F88"
                   Text="SHIFT+ALT+\ 开关捕获 · 捕获开启时键鼠被拦截，映射才驱动虚拟手柄 · 手柄输入始终转发 · 编辑映射需先关闭捕获 · 关闭窗口即退出" />
    </Grid>
</Window>
