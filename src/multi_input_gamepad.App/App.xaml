<Application x:Class="MultiInputGamepad.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MultiInputGamepad.App.Converters">
    <Application.Resources>
        <conv:OnOffBrushConverter x:Key="OnOff" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:MappedBorderConverter x:Key="MappedBorder" />
        <conv:BoolToCursorConverter x:Key="HandCursor" />

        <Style x:Key="PadKey" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="BorderBrush" Value="#3A3A3E" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PadKeyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#F2F2F2" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#9A9AA2" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#232326" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="TriggerBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="#E0A030" />
            <Setter Property="Background" Value="#3A3A3E" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9A9AA2" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 小按钮：深色圆角 -->
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3E" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- 自定义模板配系统虚线焦点框很难看：点过按钮后再用热键开捕获，键盘提示会把它画出来 -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数值/文本输入框 -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#161618" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="BorderBrush" Value="#3A3A3E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#E8E8E8" />
        </Style>

        <!-- 单选：方角标签，选中蓝底（用于目标按键 / 参数选择） -->
        <Style x:Key="PickSmall" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#D8D8DE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#2A2A2E" BorderBrush="#3A3A3E" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="used">
                                <Setter TargetName="Bg" Property="Background" Value="#1F3A28" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#4C9A6A" />
                                <Setter Property="Foreground" Value="#8FD1A8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#1E1E22" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#2A2A2E" />
                                <Setter Property="Foreground" Value="#5A5A62" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#34343A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E5FBF" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#4C9AFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 单选：手柄按键方格（与主窗口 PadKey 同形：圆角矩形 40×32） -->
        <Style x:Key="PickSquare" TargetType="RadioButton" BasedOn="{StaticResource PickSmall}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <!-- 单选：分段选择（映射类型） -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#D8D8DE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#26262A" BorderBrush="#3A3A3E" BorderThickness="1"
                                CornerRadius="6" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#34343A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E5FBF" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#4C9AFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS 风格滚动条（细、圆角、无箭头）-->
        <!-- iOS 风格：细、圆角、无箭头、鼠标悬停变亮 -->
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="7" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MaxWidth" Value="7" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent" Margin="1,0">
                                                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb MinHeight="24" Cursor="Hand">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border x:Name="Bar" Background="#45454D" CornerRadius="3" Margin="0,2" />
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bar" Property="Background" Value="#6E6E7A" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsDragging" Value="True">
                                                                            <Setter TargetName="Bar" Property="Background" Value="#8A8A98" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9A9AA2" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- 摇杆方向：四分圆扇形（上/右/下/左），圆半径 34、中心 (40,40) -->
        <PathGeometry x:Key="SectorUp">
            <PathGeometry.Figures>
                <PathFigure StartPoint="40,40" IsClosed="True">
                    <LineSegment Point="15.958,15.958" />
                    <ArcSegment Point="64.042,15.958" Size="34,34" SweepDirection="Clockwise" />
                </PathFigure>
            </PathGeometry.Figures>
        </PathGeometry>
        <PathGeometry x:Key="SectorRight">
            <PathGeometry.Figures>
                <PathFigure StartPoint="40,40" IsClosed="True">
                    <LineSegment Point="64.042,15.958" />
                    <ArcSegment Point="64.042,64.042" Size="34,34" SweepDirection="Clockwise" />
                </PathFigure>
            </PathGeometry.Figures>
        </PathGeometry>
        <PathGeometry x:Key="SectorDown">
            <PathGeometry.Figures>
                <PathFigure StartPoint="40,40" IsClosed="True">
                    <LineSegment Point="64.042,64.042" />
                    <ArcSegment Point="15.958,64.042" Size="34,34" SweepDirection="Clockwise" />
                </PathFigure>
            </PathGeometry.Figures>
        </PathGeometry>
        <PathGeometry x:Key="SectorLeft">
            <PathGeometry.Figures>
                <PathFigure StartPoint="40,40" IsClosed="True">
                    <LineSegment Point="15.958,64.042" />
                    <ArcSegment Point="15.958,15.958" Size="34,34" SweepDirection="Clockwise" />
                </PathFigure>
            </PathGeometry.Figures>
        </PathGeometry>

        <!-- 摇杆方向单选：四分圆扇区（无文字；选中蓝、被占绿） -->
        <Style x:Key="StickSector" TargetType="RadioButton">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Path x:Name="Slice"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                              Fill="#26262A" Stroke="#3A3A3E" StrokeThickness="1.5" StrokeLineJoin="Round" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="used">
                                <Setter TargetName="Slice" Property="Fill" Value="#1F3A28" />
                                <Setter TargetName="Slice" Property="Stroke" Value="#4C9A6A" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Slice" Property="Fill" Value="#34343A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Slice" Property="Fill" Value="#2E5FBF" />
                                <Setter TargetName="Slice" Property="Stroke" Value="#4C9AFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS 风格开关：胶囊轨道 + 圆形滑块（轨道高度 = 滑块直径；开启态用按键按下的绿色） -->
        <Style x:Key="IosToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="37" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- 点过开关后按热键开捕获时，WPF 会为键盘焦点画系统虚线框（自定义模板上没有对应视觉）-->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="8.5" Background="#3A3A3E" />
                            <Ellipse x:Name="Thumb" Width="17" Height="17" Fill="#F2F2F2"
                                     Stroke="Transparent" StrokeThickness="1"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4C9AFF" />
                                <Setter TargetName="Thumb" Property="Stroke" Value="#4C9AFF" />
                                <Setter TargetName="Thumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="20" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 深色下拉项（配置选择用） -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="3,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34343A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E5FBF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色下拉框 -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#232326" BorderBrush="#3A3A3E"
                                                BorderThickness="1" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="8,0,4,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                                    <!-- 选择框只显示名称：列表项的删除按钮只在展开的列表里出现，避免误触 -->
                                                    <ContentPresenter.ContentTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" Foreground="#F2F2F2" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ContentPresenter.ContentTemplate>
                                                </ContentPresenter>
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="#9A9AA2"
                                                      StrokeThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C9AFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#232326" BorderBrush="#3A3A3E" BorderThickness="1" CornerRadius="5"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
